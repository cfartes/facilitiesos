# Execute python -m backend.bootstrap para gerar .env sem senha em texto puro.
FACILITIES_ENV=development
FACILITIES_ORIGIN=http://127.0.0.1:5180
# Na API publicada, configurar também FACILITIES_ORIGIN com o domínio HTTPS.
FACILITIES_WEBHOOK_ORIGIN=https://facilities.nexusdataanalytics.tech
FACILITIES_ADMIN_EMAIL=
FACILITIES_ADMIN_PASSWORD_HASH=
FACILITIES_ENCRYPTION_KEY=
FACILITIES_DB=data/facilities.sqlite3
# PostgreSQL local: python -m backend.dev_database gera .env.database.
# A API usa apenas facilities_app/platform. facilities_owner é exclusivo de migrações.
